# Copia este archivo a ".env" y rellena tus valores. El archivo ".env" NO se sube a Git.

# --- Opción A: OpenAI (por defecto) ---
LLM_API_KEY=pon-aqui-tu-clave
# Nombre del modelo de tu cuenta (uno pequeño que soporte tool calling)
LLM_MODEL=pon-aqui-el-modelo

# --- Opción B: LLM local con Ollama (sustituye lo de arriba) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=nombre-del-modelo-descargado-en-ollama

# --- Opcionales (valores por defecto entre paréntesis) ---
# SERVICES_BASE_URL=http://127.0.0.1:8001   # dónde escuchan los servicios simulados
# DB_PATH=data/claims.db                     # histórico de eventos (SQLite)
# TRACE_PATH=logs/trace.jsonl                # traza de cada ejecución
# SERVICE_CONNECT_TIMEOUT_S=2                # tiempo máx. para conectar con un servicio
# SERVICE_READ_TIMEOUT_S=3                   # tiempo máx. esperando su respuesta
# SERVICE_MAX_ATTEMPTS=3                     # intentos totales ante fallos transitorios
# SERVICE_BACKOFF_S=0.3                      # espera base entre intentos (se duplica cada vez)
# MAX_AGENT_STEPS=6                          # tope de vueltas LLM <-> tools
# PENDING_TTL_MINUTES=5                      # caducidad de una acción pendiente de confirmar
# GUARD_ENABLED=true                         # filtro de entrada contra peticiones maliciosas (false = solo para probar las demás capas)
